
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #141e30, #243b55);
    font-family: Arial, sans-serif;
}

.calculator {
    width: 320px;
    padding: 22px;
    background: #202b3c;
    border-radius: 20px;
    box-shadow: 0 10px 30px #00000066;
}

h2 {
    text-align: center;
    color: white;
    margin-top: 0;
}

#display {
    width: 100%;
    height: 65px;
    margin-bottom: 15px;
    border: none;
    border-radius: 10px;
    background: #111827;
    color: white;
    text-align: right;
    padding: 12px;
    font-size: 28px;
}

.buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

button {
    min-height: 52px;
    border: none;
    border-radius: 10px;
    background: #374151;
    color: white;
    font-size: 20px;
    cursor: pointer;
}

button:active {
    background: #64748b;
}

button:last-child {
    grid-column: span 2;
    background: #0ea5e9;
}
